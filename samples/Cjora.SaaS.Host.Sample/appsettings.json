{
  "Modules": {
    "EnableCrmDataPermission": true,
    "EnablePmDataPermission": true
  },
  "ConnectionStrings": {
    "SqlSugar": "DataSource=cjora_sample_host.db"
  },
  "Sys": {
    "SecurityCache": {
      "AbsoluteExpirationMinutes": 7
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "SysWebOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  }
}
